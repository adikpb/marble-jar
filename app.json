{
  "expo": {
    "name": "marble-jar",
    "slug": "marble-jar",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marblejar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marblejar.app"
    },
    "android": {
      "package": "com.marblejar.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Marble Jar",
      "shortName": "Marble Jar",
      "lang": "en",
      "themeColor": "#1E1B16",
      "backgroundColor": "#FAF8F3",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/marble-jar/",
      "scope": "/marble-jar/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/marble-jar"
    }
  }
}
